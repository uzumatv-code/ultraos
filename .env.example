# Backend/API
DATABASE_URL=mysql://mysql:senha@host:3306/sistemas_os
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_TTL=12h
CORS_ORIGIN=
PORT=3000

# Recuperação de senha por Gmail SMTP
# Crie uma "senha de app" na conta Google usada para os envios.
APP_URL=https://os.seudominio.com.br
GMAIL_USER=seuemail@gmail.com
GMAIL_APP_PASSWORD=senha-de-app-do-google
MAIL_FROM="Sistema OS <seuemail@gmail.com>"

# WhatsApp SaaS gerenciado pela Evolution API (somente backend)
EVOLUTION_API_URL=http://evolution-api.railway.internal:8080
EVOLUTION_API_KEY=troque-por-uma-chave-forte
EVOLUTION_WEBHOOK_SECRET=troque-por-um-segredo-de-webhook
WHATSAPP_RECONCILE_ENABLED=true
WHATSAPP_RECONCILE_INTERVAL_MS=60000

# Frontend
# Em desenvolvimento, deixe vazio para usar o proxy do Vite.
VITE_API_URL=
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0

# OpenAI (para transcrição de áudio)
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
